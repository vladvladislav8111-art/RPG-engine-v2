{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/gateway.ts": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/api/gateway?__rpg_route=/" },
    { "source": "/health", "destination": "/api/gateway?__rpg_route=/health" },
    { "source": "/context", "destination": "/api/gateway?__rpg_route=/context" },
    { "source": "/prepare-commit", "destination": "/api/gateway?__rpg_route=/prepare-commit" },
    { "source": "/commit", "destination": "/api/gateway?__rpg_route=/commit" },
    { "source": "/rng/int", "destination": "/api/gateway?__rpg_route=/rng/int" },
    { "source": "/mcp", "destination": "/api/gateway?__rpg_route=/mcp" },
    { "source": "/diag/context", "destination": "/api/gateway?__rpg_route=/diag/context" },
    { "source": "/diag/prepare", "destination": "/api/gateway?__rpg_route=/diag/prepare" },
    { "source": "/diag/docs", "destination": "/api/gateway?__rpg_route=/diag/docs" },
    { "source": "/diag/mcp", "destination": "/api/gateway?__rpg_route=/diag/mcp" }
  ]
}
